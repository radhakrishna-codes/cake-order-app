# Local dev: leave empty to use Vite proxy (localhost:5174 → localhost:8000)
# Production / remote API: set to your deployed backend URL (no trailing slash)
# VITE_API_URL=https://your-app.up.railway.app

# Production build uses .env.production automatically when you run:
#   pnpm build
# Output is copied to: releases/cake-order-app/
# Install on iPhone/iPad: host on HTTPS → Safari → Share → Add to Home Screen
